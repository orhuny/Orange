APP_NAME=Orange
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----- Database (PostgreSQL via docker-compose) -----
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=orange
DB_USERNAME=orange
DB_PASSWORD=orange
FORWARD_DB_PORT=5432

# ----- Session / Cache / Queue (Redis-backed) -----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ----- Redis -----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
FORWARD_REDIS_PORT=6379

# ----- Broadcast (Laravel Reverb / WebSocket) -----
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=orange
REVERB_APP_KEY=orange-key
REVERB_APP_SECRET=orange-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

# Server-side bind. Reverb reads these (NOT REVERB_PORT) for its socket.
# Override on Windows hosts where Hyper-V reserves 8080 (e.g. set both to 8090).
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ----- Mail (Mailpit via docker-compose) -----
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@orange.local"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ----- Filesystem -----
FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----- Game Engine -----
GAME_CRASH_GROWTH_RATE=0.06
GAME_CRASH_WAITING_SECONDS=5
GAME_CRASH_BETTING_SECONDS=10
GAME_CRASH_TICK_INTERVAL_MS=100
GAME_CRASH_HOUSE_EDGE_DIVISOR=33

# ----- Provably Fair -----
PROVABLY_FAIR_HOUSE_CLIENT_SEED=orange-house-seed-rotate-me
PROVABLY_FAIR_SEED_ROTATION_ROUNDS=1000

# ----- Operator API -----
OPERATOR_API_TIMESTAMP_WINDOW_SECONDS=30
OPERATOR_API_IDEMPOTENCY_TTL_HOURS=24
OPERATOR_API_DEFAULT_RATE_LIMIT_PER_MINUTE=600

# ----- Wallet Callback (provider -> operator HTTP) -----
WALLET_CALLBACK_TIMEOUT_SECONDS=5
WALLET_CALLBACK_RETRY_ATTEMPTS=3
WALLET_CALLBACK_RETRY_BACKOFF_MS=500

# ----- Risk / Limits -----
RISK_MAX_BET_DEFAULT=1000
RISK_MAX_WIN_DEFAULT=100000
RISK_MAX_EXPOSURE_PER_ROUND=500000

# ----- Telescope (dev only) -----
TELESCOPE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
