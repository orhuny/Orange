includes:
    - vendor/larastan/larastan/extension.neon
    # Findings that predate CI running PHPStan 2 cleanly; new code must not add to it.
    - phpstan-baseline.neon

parameters:
    paths:
        - app
        - database/factories
        - database/seeders
        - tests
    level: 6
    excludePaths:
        - app/Filament/**/Pages/**
    ignoreErrors:
        # PHPStan 2 replacement for the removed checkMissingIterableValueType: false
        - identifier: missingType.iterableValue
